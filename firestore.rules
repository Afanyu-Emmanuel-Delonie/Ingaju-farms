rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Operations portal: orders, inquiries, and other submissions.
    // Only signed-in portal users can read or create them.
    match /portal_submissions/{submissionId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // Blog posts authored from the portal. Published posts are public
    // (read by the marketing site's blog pages); drafts are only visible
    // to signed-in portal users. Writes require sign-in.
    match /blog_posts/{postId} {
      allow read: if resource.data.published == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // Leads from public site forms (contact page + order/tour/training
    // request modal). Anyone can create one; only signed-in staff can
    // read, update, or delete them.
    match /leads/{leadId} {
      allow create: if request.resource.data.source in ['contact', 'order', 'tour', 'training']
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if request.auth != null;
    }
  }
}
