# Firebase — copy this file to .env.local and fill in real values from the
# Firebase console (Project settings → General → Your apps → SDK setup).
# Set NEXT_PUBLIC_FIREBASE_DISABLED=true to run the app with auth/Firestore
# features turned off (no credentials required).
NEXT_PUBLIC_FIREBASE_DISABLED=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Resend — used server-side only (src/app/api/notify) to email the team
# when someone submits the contact form or an order/tour/training request.
# Get an API key at https://resend.com/api-keys. FROM_EMAIL must be on a
# domain verified in Resend (onboarding@resend.dev works for testing).
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_EMAIL_CC=
FROM_EMAIL=
